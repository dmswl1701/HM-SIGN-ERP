{
  // HM SIGN ERP — Cloudflare Workers 설정
  // GitHub main 브랜치에 push 하면 Workers Builds 가 이 파일을 읽어 자동 배포합니다.
  // ERP 는 index.html 한 개짜리 정적 사이트이므로 Worker 스크립트 없이 정적 자산만 배포합니다.
  "$schema": "node_modules/wrangler/config-schema.json",

  // 기존에 운영 중인 Worker 이름과 반드시 동일해야 합니다. (다르면 새 Worker 가 생성됨)
  "name": "hm-sign-erp",

  "compatibility_date": "2026-08-06",

  "assets": {
    // 이 폴더 안의 파일이 그대로 배포됩니다.
    "directory": "./public",

    // 없는 경로로 들어와도 index.html 을 돌려줍니다.
    // ERP 는 화면 전환을 자바스크립트로 처리하므로 새로고침 시 404 가 나지 않게 하는 설정입니다.
    "not_found_handling": "single-page-application"
  },

  // 배포 기록을 남겨 문제가 생기면 이전 버전으로 되돌릴 수 있게 합니다.
  "observability": {
    "enabled": true
  }
}
